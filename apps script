  const raw = `${graded.correct} / ${max}`;
  const pct = `${graded.percent}%`;

  results.getRange(cell).setValue(`${raw}  (${pct})`);
}

/*************** UPDATE OVERALL + CONCEPT MASTERY ***************/
function updateOverallAndConcepts_(ss) {
  const results = ss.getSheetByName("RESULTS");
  const keySheet = ss.getSheetByName("ANSWER_KEY");
  const pre = getLatestSectionScore_(ss, "MCQ_PRE");
  const mid = getLatestSectionScore_(ss, "MCQ_MID");
  const post = getLatestSectionScore_(ss, "MCQ_POST");

  // Weighted overall (if a section missing, weight is ignored for now)
  const parts = [];
  let weightSum = 0;

  if (pre) { parts.push(pre.percent * WEIGHTS.PRE); weightSum += WEIGHTS.PRE; }
  if (mid) { parts.push(mid.percent * WEIGHTS.MID); weightSum += WEIGHTS.MID; }
  if (post) { parts.push(post.percent * WEIGHTS.POST); weightSum += WEIGHTS.POST; }

  const overall = weightSum > 0 ? Math.round(parts.reduce((a,b)=>a+b,0) / weightSum) : 0;
  results.getRange(RESULTS_CELLS.overallCard).setValue(weightSum > 0 ? `${overall}%` : "— %");

  // Aggregate concept misses across all graded sections
  const conceptMisses = aggregateConceptMisses_(ss);

  // Write concept mastery statuses (✔ Strong / ⚠ Review)
  const start = RESULTS_CELLS.conceptStartRow;
  for (let i = 0; i < 30; i++) {
    const nameCell = `${RESULTS_CELLS.conceptNameCol}${start + i}`;
    const statusCell = `${RESULTS_CELLS.conceptStatusCol}${start + i}`;

    const conceptName = String(results.getRange(nameCell).getValue()).trim();
    if (!conceptName) break;

    const misses = conceptMisses[conceptName] || 0;

    // Rule: 0–1 misses => Strong; 2+ => Review
    const status = (misses >= 2) ? "⚠ Review" : "✔ Strong";
    results.getRange(statusCell).setValue(status);
  }

  // Status line stays placeholder until finalize step
  // results.getRange(RESULTS_CELLS.status).setValue("STATUS: —");
}
function tierMin_(a, b) {
  const rank = { GOLD: 3, SILVER: 2, BRONZE: 1 };
  return rank[a] <= rank[b] ? a : b;
}
/*************** LATEST SCORE LOOKUP (from SYSTEM_LOG) ***************/
function getLatestSectionScore_(ss, sectionName) {
  const log = ensureLogSheet_(ss);
  const data = log.getDataRange().getValues();
  // Columns: timestamp, email, action, correct, total, percent
  for (let i = data.length - 1; i >= 1; i--) {
    if (String(data[i][2]) === sectionName) {
      return {
        correct: Number(data[i][3]),
        total: Number(data[i][4]),
        percent: Number(data[i][5])
      };
    }
  }
  return null;
}

/*************** CONCEPT MISS AGGREGATION ***************/
function aggregateConceptMisses_(ss) {
  const log = ensureLogSheet_(ss);
  const data = log.getDataRange().getValues();

  // We store misses summary JSON in column G (index 6)
  const conceptMisses = {};

  for (let i = 1; i < data.length; i++) {
    const action = String(data[i][2]);
    if (action !== "MCQ_PRE" && action !== "MCQ_MID" && action !== "MCQ_POST") continue;

    const json = String(data[i][6] || "").trim();
    if (!json) continue;

    try {
      const obj = JSON.parse(json);
      Object.keys(obj).forEach(k => {
        conceptMisses[k] = (conceptMisses[k] || 0) + Number(obj[k] || 0);
      });
    } catch (e) {
      // ignore malformed rows
    }
  }

  return conceptMisses;
}

/*************** LOGGING ***************/
function ensureLogSheet_(ss) {
  let log = ss.getSheetByName("SYSTEM_LOG");
  if (!log) {
    log = ss.insertSheet("SYSTEM_LOG");
    log.appendRow(["Timestamp", "Email", "Action", "Correct", "Total", "Percent", "MissesByConceptJSON"]);
  }
  return log;
}

function logAttempt_(ss, email, action, graded) {
  const log = ensureLogSheet_(ss);
  log.appendRow([
    new Date(),
    email,
    action,
    graded.correct,
    graded.total,
    graded.percent,
    JSON.stringify(graded.missesByConcept || {})
  ]);
}
function computeSIMQuality_(sim) {
  const base = [
    Number(sim.getRange("G30").getValue()),
    Number(sim.getRange("G31").getValue()),
    Number(sim.getRange("G32").getValue()),
    Number(sim.getRange("G33").getValue())
  ];

  if (base.some(isNaN)) return null;

  const avg = Math.round(base.reduce((a,b)=>a+b,0) / base.length);

  if (avg >= 85) return { score: avg, tier: "STRONG" };
  if (avg >= 70) return { score: avg, tier: "STABLE" };
  return { score: avg, tier: "FRAGILE" };
}

function finalizeResults() {
  const ss = SpreadsheetApp.getActive();
  const results = ss.getSheetByName("RESULTS");
  const sim = ss.getSheetByName("SIM");

  const email = getStudentEmail_();

  // ----- SHOCK CHECK -----
  if (String(sim.getRange("E29").getValue()).trim() !== "SHOCK_APPLIED") {
    SpreadsheetApp.getUi().alert(
      "Shock Required",
      "Please run and resolve the market shock before finalizing results.",
      SpreadsheetApp.getUi().ButtonSet.OK
    );
    return;
  }

  // ----- MCQ CHECK (LOG-BASED, AUTHORITATIVE) -----
  const pre = getLatestSectionScore_(ss, "MCQ_PRE");
  const mid = getLatestSectionScore_(ss, "MCQ_MID");
  const post = getLatestSectionScore_(ss, "MCQ_POST");

  if (!pre || !mid || !post) {
    SpreadsheetApp.getUi().alert(
      "MCQs Not Graded",
      "Please grade all MCQ sections before finalizing results.",
      SpreadsheetApp.getUi().ButtonSet.OK
    );
    return;
  }

  const overallPct = Math.round(
    (pre.percent * WEIGHTS.PRE +
     mid.percent * WEIGHTS.MID +
     post.percent * WEIGHTS.POST) /
    (WEIGHTS.PRE + WEIGHTS.MID + WEIGHTS.POST)
  );

  results.getRange(RESULTS_CELLS.overallCard).setValue(`${overallPct}%`);

  // ----- SIM QUALITY -----
  const simQuality = computeSIMQuality_(sim);
  if (!simQuality) {
    results.getRange(RESULTS_CELLS.status).setValue("STATUS: REVIEW REQUIRED");
    results.getRange(RESULTS_CELLS.causeBox)
      .setValue("Simulation baseline missing. Re-run SIM.");
    return;
  }

  const orders = Number(sim.getRange("E30").getValue());
  const partners = Number(sim.getRange("E31").getValue());
  const drivers = Number(sim.getRange("E32").getValue());
  const platform = Number(sim.getRange("E33").getValue());

  const shockAvg = Math.round((orders + partners + drivers + platform) / 4);

  // ----- PASS / FAIL -----
  let pass = true;
  let reason = "";

  if (overallPct < 65) {
    pass = false;
    reason = "Overall MCQ score below passing threshold.";
  } else if (simQuality.tier === "FRAGILE") {
    pass = false;
    reason = "Simulation created an unstable system.";
  } else if (orders < 60 || partners < 60 || drivers < 60) {
    pass = false;
    reason = "System failed under market shock.";
  }

  if (!pass) {
    results.getRange(RESULTS_CELLS.status).setValue("STATUS: REVIEW REQUIRED");
    results.getRange(RESULTS_CELLS.causeBox)
      .setValue(reason);
    sendFailEmail_(email, reason, "");
    SpreadsheetApp.getUi().alert(
  "Review Required",
  reason,
  SpreadsheetApp.getUi().ButtonSet.OK
);

    return;
  }

  const mcqTier = overallPct >= 90 ? "GOLD" : overallPct >= 75 ? "SILVER" : "BRONZE";
  const shockTier = shockAvg >= 85 ? "GOLD" : shockAvg >= 70 ? "SILVER" : "BRONZE";
  const finalTier = tierMin_(mcqTier, shockTier);

  results.getRange(RESULTS_CELLS.status)
    .setValue(`STATUS: PASS — ${finalTier}`);

  results.getRange(RESULTS_CELLS.causeBox)
    .setValue(
      `MCQ Mastery: ${overallPct}%\n` +
      `Simulation Quality: ${simQuality.tier} (${simQuality.score})\n` +
      `Shock Resilience: ${shockAvg}\n`
    );

  const claimCode = generateClaimCode_(finalTier);
  sendPassEmail_(email, claimCode);

  SpreadsheetApp.getUi().alert(
    "Module Passed",
    `Congratulations! You passed Module 2 (${finalTier}).`,
    SpreadsheetApp.getUi().ButtonSet.OK
  );
}


/**
 * Shock response deltas: keep these modest.
 * We do NOT want shock to be overly punitive.
 */
function getShockResponseDeltas_(response, scenarioId) {

  const map = {
    "Raise customer prices": { orders: -7, partners: +1, platform: +6 },
    "Reduce partner payouts": { orders: +1, partners: -7, platform: +6 },
    "Accept lower platform profit": { orders: +4, partners: +4, platform: -7 },
    "Cut service levels": { orders: -6, partners: -4, platform: +2 }
  };

  // Default safe
  return map[response] || { orders: 0, partners: 0, platform: 0 };
}

/**
 * Normalizes shock response text so minor spelling/case differences don’t break grading.
 * (Your current dropdown shows slightly truncated labels; this prevents errors.)
 */
function normalizeShockResponse_(raw) {
  const t = normalizeText_(raw);

  if (t.startsWith("raise")) return "Raise customer prices";
  if (t.startsWith("reduce")) return "Reduce partner payouts";
  if (t.startsWith("accept")) return "Accept lower platform profit";
  if (t.startsWith("cut")) return "Cut service levels";

  // fallback: return raw (but evaluation may not find deltas)
  return raw.trim();
}

function label_(score) {
  if (score >= 85) return "Strong";
  if (score >= 70) return "Stable";
  return "Decreasing";
}

function clamp_(n, lo, hi) {
  return Math.max(lo, Math.min(hi, n));
}

function randInt_(min, max) {
  return Math.floor(Math.random() * (max - min + 1)) + min;
}

function normalizeText_(s) {
  return String(s || "")
    .toLowerCase()
    .replace(/\s+/g, " ")
    .trim();
}

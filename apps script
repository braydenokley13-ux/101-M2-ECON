/*************** CORE: GRADE ONE SECTION ***************/
function gradeSection_(sectionSheetName) {
  const ss = SpreadsheetApp.getActive();
  const email = getStudentEmail_();

  const mcqSheet = ss.getSheetByName(sectionSheetName);
  if (!mcqSheet) throw new Error(`Missing sheet: ${sectionSheetName}`);

  const keySheet = ss.getSheetByName("ANSWER_KEY");
  if (!keySheet) throw new Error('Missing sheet: "ANSWER_KEY"');

  const results = ss.getSheetByName("RESULTS");
  if (!results) throw new Error('Missing sheet: "RESULTS"');

  const answerKey = loadAnswerKey_(keySheet, sectionSheetName);
  const studentAnswers = readStudentAnswers_(mcqSheet, answerKey.total);

  // Grade
  const graded = gradeAnswers_(sectionSheetName, studentAnswers, answerKey);

  // Write section score card
  writeSectionScoreToResults_(results, sectionSheetName, graded);

  // Update overall snapshot + concept mastery (based on whatever has been graded so far)
  updateOverallAndConcepts_(ss);

  // Log
  logAttempt_(ss, email, sectionSheetName, graded);

  SpreadsheetApp.getUi().alert(
    "Section Graded",
    `${sectionSheetName} scored ${graded.correct}/${graded.total} (${graded.percent}%).`,
    SpreadsheetApp.getUi().ButtonSet.OK
  );
}

/*************** LOAD ANSWER KEY ***************/
function loadAnswerKey_(keySheet, sectionName) {
  const data = keySheet.getDataRange().getValues();
  // Expected columns: SECTION | QUESTION | CORRECT
  const keyByQ = {};
  let total = 0;

  for (let i = 1; i < data.length; i++) {
    const row = data[i];
    const sec = String(row[0]).trim();
    const q = Number(row[1]);
    const corr = String(row[2]).trim().toUpperCase();

    if (sec === sectionName && q && corr) {
      keyByQ[q] = corr;
      total = Math.max(total, q);
    }
  }

  if (total === 0) throw new Error(`No key rows found for ${sectionName} in ANSWER_KEY.`);

  return { keyByQ, total };
}

/*************** READ STUDENT ANSWERS (NO HARDCODED CELLS) ***************/
// Finds rows where column B contains "Your Answer:" and reads column C for the letter.
function readStudentAnswers_(mcqSheet, expectedCount) {
  const lastRow = mcqSheet.getLastRow();
  const colB = mcqSheet.getRange(1, 2, lastRow, 1).getValues(); // B
  const answers = [];

  for (let r = 0; r < colB.length; r++) {
    const v = String(colB[r][0]).trim().toLowerCase();
    if (v === "your answer:" || v === "your answer") {
      const letter = String(mcqSheet.getRange(r + 1, 3).getValue()).trim().toUpperCase(); // C
      answers.push(letter);
    }
  }

  // If template changes, we still want to fail loudly instead of silently.
  if (expectedCount && answers.length < expectedCount) {
    throw new Error(
      `Found only ${answers.length} answer cells in ${mcqSheet.getName()}, expected ${expectedCount}. ` +
      `Make sure each question has "Your Answer:" in column B and dropdown in column C.`
    );
  }

  return answers.slice(0, expectedCount);
}

/*************** GRADE ANSWERS ***************/
function gradeAnswers_(sectionName, studentAnswers, answerKey) {
  let correct = 0;
  const missesByConcept = {};
  const missedQuestions = [];

  for (let q = 1; q <= answerKey.total; q++) {
    const student = (studentAnswers[q - 1] || "").toUpperCase();
    const key = (answerKey.keyByQ[q] || "").toUpperCase();

    const isCorrect = student && key && student === key;
    if (isCorrect) {
      correct++;
    } else {
      const mapKey = `${sectionName}_${q}`;
      const concept = QUESTION_CONCEPT_MAP[mapKey] || "Unmapped";
      missesByConcept[concept] = (missesByConcept[concept] || 0) + 1;
      missedQuestions.push({ q, student: student || "—", key, concept });
    }
  }

  const total = answerKey.total;
  const percent = Math.round((correct / total) * 100);

  return { correct, total, percent, missesByConcept, missedQuestions };
}


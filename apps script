/*************** SHOCK EXPLANATION *****************/
function buildShockExplanation_(orders, partners, platform) {
  const parts = [];

  if (orders < 70) {
    parts.push(
      "Customer demand declined under higher costs, indicating sensitivity to price or service changes."
    );
  } else if (orders >= 85) {
    parts.push(
      "Customer demand remained strong, suggesting your system absorbed the cost increase well."
    );
  }

  if (partners < 70) {
    parts.push(
      "Partner stability weakened, showing that some suppliers or partners were negatively affected by the response."
    );
  } else if (partners >= 85) {
    parts.push(
      "Partners remained stable, indicating a sustainable revenue-sharing structure."
    );
  }

  if (platform < 70) {
    parts.push(
      "Platform health declined, suggesting profit pressure or operational strain."
    );
  } else if (platform >= 85) {
    parts.push(
      "Platform health remained strong, showing resilience under market pressure."
    );
  }

  if (parts.length === 0) {
    return "The system responded moderately to the market shock with mixed outcomes.";
  }

  return parts.join(" ");
}
/***************************************************
 * MODULE 2 — SIM ENGINE
 * Writes SIM outcomes to OUTCOMES block
 ***************************************************/
function runSIM() {
  const ss = SpreadsheetApp.getActive();
  const sim = ss.getSheetByName("SIM");
  if (!sim) throw new Error('Missing "SIM" sheet.');

  // Prevent re-run
  const lockCell = sim.getRange("E28").getValue();
  if (lockCell === "SIM_COMPLETE") {
    SpreadsheetApp.getUi().alert(
      "SIM Locked",
      "The SIM build has already been finalized.",
      SpreadsheetApp.getUi().ButtonSet.OK
    );
    return;
  }

  // Read decisions (CHANGE CELLS IF NEEDED)
  const d1 = String(sim.getRange("C9").getValue()).trim();
  const d2 = String(sim.getRange("C13").getValue()).trim();
  const d3 = String(sim.getRange("C17").getValue()).trim();
  const d4 = String(sim.getRange("C21").getValue()).trim();

  if (!d1 || !d2 || !d3 || !d4) {
    SpreadsheetApp.getUi().alert(
      "Incomplete Build",
      "Please complete all four SIM decisions before running the build.",
      SpreadsheetApp.getUi().ButtonSet.OK
    );
    return;
  }

  // Base scores
  let orders = 70;
  let restaurants = 70;
  let drivers = 70;
  let competition = 70;

  // DECISION 1 — Revenue Generation
if (d1 === "Charge customers a delivery fee") {
  orders -= 10;
  competition += 5;
}

if (d1 === "Take a commission from restaurants") {
  restaurants -= 15;
  drivers -= 5;
}

if (d1 === "Offer monthly subscriptions") {
  orders += 10;
  competition += 5;
}
// DECISION 2 — Market Size
if (d2 === "Operate in one large city") {
  orders += 5;
  competition -= 5;
}

if (d2 === "Operate in many small towns") {
  orders += 10;
  drivers -= 5;
}
// DECISION 3 — Revenue Sharing
if (d3 === "Platform keeps a larger share") {
  restaurants -= 10;
  drivers -= 10;
}

if (d3 === "Platform and partners split evenly") {
  competition += 5;
}

if (d3 === "Partners keep a larger share") {
  restaurants += 10;
  drivers += 10;
}
// DECISION 4 — Competitive Balance
if (d4 === "Lower fees for small businesses") {
  competition += 15;
  orders += 5;
}

if (d4 === "Same rules for all businesses") {
  competition += 5;
}

if (d4 === "Special deals for large chains") {
  competition -= 15;
  restaurants -= 10;
}

  // Clamp values 0–100
  function clamp(n) { return Math.max(0, Math.min(100, n)); }

  orders = clamp(orders);
  restaurants = clamp(restaurants);
  drivers = clamp(drivers);
  competition = clamp(competition);

  // Write outcomes
  sim.getRange("E30").setValue(orders);
  sim.getRange("E31").setValue(restaurants);
  sim.getRange("E32").setValue(drivers);
  sim.getRange("E33").setValue(competition);
// Snapshot baseline SIM results (pre-shock)
sim.getRange("G30").setValue(orders);
sim.getRange("G31").setValue(restaurants);
sim.getRange("G32").setValue(drivers);
sim.getRange("G33").setValue(competition);
sim.getRange("G36").setValue("BASELINE");

  // System Health Score
  const systemHealth = Math.round(
    (orders + restaurants + drivers + competition) / 4
  );
  sim.getRange("E35").setValue(systemHealth);

  // Fail logic (educational, not punitive)
  let failReason = "";
  if (drivers < 50) failReason = "Drivers quit (pay/incentives)";
  if (restaurants < 50) failReason = "Restaurants leave platform";
  if (competition < 50) failReason = "Market becomes unbalanced";

  sim.getRange("E36").setValue(failReason || "—");

  // Lock SIM
  sim.getRange("E28").setValue("SIM_COMPLETE");

  SpreadsheetApp.getUi().alert(
    "SIM Build Complete",
    "System outcomes have been calculated. You may now proceed to the Market Shock.",
    SpreadsheetApp.getUi().ButtonSet.OK
  );
}
